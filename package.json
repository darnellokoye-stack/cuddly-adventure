{
  "name": "base-token-discovery",
  "version": "1.0.0",
  "description": "A standalone token and pair discovery microservice for the Base blockchain.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsup",
    "start": "node dist/server.js",
    "dev": "tsup --watch",
    "test": "vitest run",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write ."
  },
  "keywords": [
    "base",
    "token",
    "discovery",
    "blockchain",
    "crypto",
    "microservice"
  ],
  "author": "base-token-discovery",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "axios": "^1.6.6",
    "dotenv": "^16.3.1",
    "express": "^4.18.4",
    "node-cron": "^3.0.2",
    "pino": "^8.16.0",
    "zod": "^3.23.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.18",
    "@types/node": "^20.15.0",
    "@types/supertest": "^2.0.14",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2",
    "tsup": "^8.5.1",
    "typescript": "^5.6.2",
    "vitest": "^0.40.0"
  }
}
